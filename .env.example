# Google Places API
# Obtain from: https://console.cloud.google.com/apis/library/places-backend.googleapis.com
# Enable "Places API" on a project with billing enabled
GOOGLE_PLACES_API_KEY=

# Companies House API (UK)
# Obtain from: https://developer.company-information.service.gov.uk/
# Register for a free account and create an application
COMPANIES_HOUSE_API_KEY=

# Anthropic API (Claude)
# Obtain from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Server port (default: 3000)
PORT=3000
